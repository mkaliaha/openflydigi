#!/usr/bin/env python3
"""Play a tone into each channel of a real DualSense, one at a time.

Maps channel index to physical output: which channels drive the haptic
actuators, which drive the speaker, and which do nothing. That cannot be
determined by observation alone -- it needs a human to report what they feel
and hear.

    tools/ds5-channel-probe              # low tone, good for feeling
    tools/ds5-channel-probe --freq 800   # higher, good for hearing the speaker

The channel map is declared explicitly: without it PipeWire remixes and the
tone does not land where intended.
"""
import argparse
import math
import shutil
import struct
import subprocess
import sys
import time

RATE = 48000
CHANNELS = 4
CHANNEL_MAP = "front-left,front-right,rear-left,rear-right"


def find_sink():
    out = subprocess.run(["pactl", "list", "short", "sinks"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and "DualSense" in parts[1]:
            return parts[1]
    return None


def tone(channel, seconds, freq, amp):
    data = bytearray()
    for n in range(int(RATE * seconds)):
        v = amp * math.sin(2 * math.pi * freq * n / RATE)
        frame = [v if c == channel else 0.0 for c in range(CHANNELS)]
        data += struct.pack("<4f", *frame)
    return bytes(data)


def play(sink, payload):
    tool = shutil.which("paplay")
    if not tool:
        sys.exit("need paplay")
    cmd = [tool, "-d", sink, "--raw", "--format=float32le",
           f"--rate={RATE}", f"--channels={CHANNELS}",
           f"--channel-map={CHANNEL_MAP}"]
    proc = subprocess.run(cmd, input=payload, stderr=subprocess.DEVNULL)
    return proc.returncode


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--sink")
    ap.add_argument("--freq", type=float, default=70.0)
    ap.add_argument("--amp", type=float, default=0.7)
    ap.add_argument("--seconds", type=float, default=2.0)
    ap.add_argument("--channel", type=int, help="probe one channel only")
    args = ap.parse_args()

    sink = args.sink or find_sink()
    if not sink:
        sys.exit("no DualSense sink found")
    print(f"sink: {sink}")
    print(f"tone: {args.freq:.0f} Hz, amplitude {args.amp}, {args.seconds:.0f}s each\n")

    channels = [args.channel] if args.channel is not None else range(CHANNELS)
    for ch in channels:
        print(f"  >>> CHANNEL {ch} <<<", flush=True)
        play(sink, tone(ch, args.seconds, args.freq, args.amp))
        time.sleep(1.0)
    print("\ndone -- for each channel, was it: strong rumble / light buzz / "
          "audible sound from the controller / nothing?")


if __name__ == "__main__":
    main()
