"""Present the Apex 5 to games as a DualSense, and translate its effects back.

    Apex 5 ──evdev──► relay ──► virtual DualSense (uhid) ──► game
                        ▲                                    │
                        └────── DS5 output reports ◄──────────┘
                        │       (trigger effects, rumble)
                        ▼
                  Flydigi cmd 81 / 0x12

For the 15 games that natively speak DualSense. Games see a real DualSense --
the kernel's hid-playstation driver binds to it and builds the usual device
tree.

    tools/flydigi-ds5              # run
    tools/flydigi-ds5 --dump       # decode effects, do not drive the pad

Tell games to ignore the physical pad so they bind to the virtual one:
    SDL_GAMECONTROLLER_IGNORE_DEVICES=0x37d7/0x2501 %command%
"""
import argparse
import os
import select
import signal
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import ds5, ds5_usb, effects, evdev, motion, relay, uhid  # noqa: E402
from flydigi.device import Controller, DeviceNotFound  # noqa: E402

FLYDIGI_VID, FLYDIGI_PID = relay.FLYDIGI_VID, relay.FLYDIGI_PID


def log(msg):
    print(f"[ds5] {msg}", flush=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dump", action="store_true",
                    help="print decoded effects, do not drive the Apex 5")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--no-motion", action="store_true",
                    help="do not enable the vendor motion stream (no gyro)")
    ap.add_argument("--gyro-scale", type=float, default=1.0,
                    help="scale factor applied to gyro values; tune by feel")
    ap.add_argument("--accel-scale", type=float, default=motion.ACCEL_SCALE,
                    help=f"scale factor applied to accelerometer values "
                         f"(default {motion.ACCEL_SCALE:.3f}, derived from the "
                         f"DualSense calibration we advertise)")
    args = ap.parse_args()

    # Turn SIGTERM into the same clean shutdown as Ctrl-C. Without this, being
    # killed leaves the controller streaming raw data and any trigger effect
    # still applied, because the cleanup below never runs.
    def _terminate(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)

    path, name = evdev.find_device(vendor=FLYDIGI_VID, product=FLYDIGI_PID,
                                   axes=True)
    if not path:
        path, name = evdev.find_device(name="Apex", axes=True)
    if not path:
        sys.exit("Apex 5 gamepad not found in /dev/input -- is it connected?")
    log(f"input: {name} ({path})")

    ctrl = None
    if not args.dump:
        try:
            ctrl = Controller()
            log(f"controller: {ctrl.path}")
        except DeviceNotFound:
            log("vendor interface not found; effects will not be applied")

    # Descriptor and feature reports come from ds5_usb.py, captured off real
    # hardware, rather than from inputtino. inputtino's descriptor is 273 bytes
    # against the hardware's 289 -- it stops short of feature reports 0x0B and
    # 0x0C -- and its calibration and firmware blobs belong to a different unit
    # of a different vintage.
    #
    # uhid replies to UHID_GET_REPORT with the payload verbatim, and a numbered
    # report's reply includes its id, so prepend it: ds5_usb stores bodies
    # without one precisely so that whoever serves them adds it exactly once.
    virtual = uhid.Device(
        "Wireless Controller", ds5_usb.VENDOR_ID, ds5_usb.PRODUCT_ID,
        ds5_usb.REPORT_DESC,
        bus=uhid.BUS_USB, version=0x8111,
        feature_reports={rid: bytes([rid]) + body
                         for rid, body in ds5_usb.FEATURE_REPORTS.items()})
    log("virtual DualSense created")
    log("games: set SDL_GAMECONTROLLER_IGNORE_DEVICES=0x37d7/0x2501")

    motion_on = False
    if ctrl and not args.no_motion:
        motion_on = motion.enable(ctrl)
        log(f"motion stream: {'enabled' if motion_on else 'FAILED to enable'}")

    state = ds5.InputState()
    applied = {}
    last_rumble = None
    left_motor = 0      # Flydigi stashes this and reuses it for one left case
    frames = 0
    motion_frames = 0
    last_info = None
    next_info_poll = 0.0

    try:
        with evdev.Reader(path) as reader:
            relay.build_state(reader, state)
            virtual.send_input(state.pack())
            watch = [reader.fileno(), virtual.fd]
            if motion_on:
                watch.append(ctrl.fd)
            while True:
                ready, _, _ = select.select(watch, [], [], 1.0)
                if motion_on and ctrl.fd in ready:
                    # Motion arrives at ~300 Hz, far faster than evdev events.
                    # Fold it into the state and emit, so aiming stays smooth
                    # rather than only updating when a stick moves.
                    report = motion.read_report(ctrl)
                    if report and report[0] == "motion":
                        _kind, gyro, accel = report
                        state.gyro = [v * args.gyro_scale for v in gyro]
                        state.accel = [v * args.accel_scale for v in accel]
                        state.sensor_timestamp += 188  # ~0.33us units at 300 Hz
                        virtual.send_input(state.pack())
                        motion_frames += 1
                    elif report and report[0] == "info":
                        info = report[1]
                        level = info["battery_level"]
                        if info["charging"]:
                            state.battery_status = ds5.BATTERY_CHARGING
                            state.battery_charge = 10
                        else:
                            # Flydigi reports 0..5; DualSense wants 0..10.
                            state.battery_charge = min(10, level * 2)
                            state.battery_status = (
                                ds5.BATTERY_FULL if level >= motion.MAX_LEVEL
                                else ds5.BATTERY_DISCHARGING)
                        if info != last_info:
                            last_info = info
                            log(f"battery {level}/5"
                                f"{' (charging)' if info['charging'] else ''}"
                                f", {info['connect_type']}")
                if motion_on and time.time() >= next_info_poll:
                    # Battery only changes slowly; poll rarely.
                    next_info_poll = time.time() + 30.0
                    motion.request_info(ctrl)
                if reader.fileno() in ready:
                    if reader.read():
                        relay.build_state(reader, state)
                        virtual.send_input(state.pack())
                        frames += 1
                if virtual.fd in ready:
                    for _rtype, data in virtual.poll(0.0):
                        parsed = ds5.parse_output(data)
                        rumble = parsed["rumble"]
                        if rumble:
                            left_motor = rumble[0]
                        if rumble and rumble != last_rumble:
                            last_rumble = rumble
                            if not args.quiet:
                                log(f"rumble {rumble}")
                            if ctrl:
                                # wait=0 is mandatory here: the default 0.1
                                # spends 100 ms per update waiting for an ACK
                                # that carries nothing, on the loop that feeds
                                # the virtual pad.
                                effects.rumble(ctrl, rumble[0], rumble[1],
                                               wait=0.0)
                        for effect in parsed["effects"]:
                            if applied.get(effect.side) == effect.key():
                                continue
                            applied[effect.side] = effect.key()
                            mapped = relay.translate(effect, left_motor)
                            if mapped is None:
                                # Unrecognised effect: leave the trigger alone,
                                # as Flydigi does. Logged so unmapped patterns
                                # from new games are visible.
                                if not args.quiet:
                                    log(f"{effect} -> unmapped, trigger unchanged")
                                continue
                            side, mode, params = mapped
                            if not args.quiet:
                                log(f"{effect} -> mode={mode} params={params}")
                            if ctrl:
                                ctrl.send(
                                    effects.common_effect_payload(side, mode, params),
                                    wait=0.0)
    except KeyboardInterrupt:
        log(f"stopping after {frames} input frames, {motion_frames} motion frames")
    finally:
        virtual.destroy()
        if ctrl:
            if motion_on:
                try:
                    motion.disable(ctrl)
                except OSError:
                    pass
            try:
                effects.clear_all(ctrl)
            except OSError:
                pass
            ctrl.close()


if __name__ == "__main__":
    main()
