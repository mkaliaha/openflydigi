"""Present the Apex 5 to games as a DualSense, and translate its effects back.

    Apex 5 ──evdev──► relay ──► virtual DualSense (uhid) ──► game
                        ▲                                    │
                        └────── DS5 output reports ◄──────────┘
                        │       (trigger effects, rumble)
                        ▼
                  Flydigi cmd 81 / 0x12

For the 15 games that natively speak DualSense. Games see a real DualSense --
the kernel's hid-playstation driver binds to it and builds the usual device
tree.

    tools/flydigi-ds5              # run
    tools/flydigi-ds5 --dump       # decode effects, do not drive the pad

Tell games to ignore the physical pad so they bind to the virtual one. Both
spellings, because SDL3 renamed the hint and a game ignores the name it does
not know:
    SDL_GAMECONTROLLER_IGNORE_DEVICES=0x37d7/0x2501 SDL_JOYSTICK_IGNORE_DEVICES=0x37d7/0x2501 %command%
"""
import argparse
import os
import select
import signal
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import (ds5, ds5_usb, dsmode, effects, motion, registry, relay,  # noqa: E402
                     uhid)


def log(msg):
    print(f"[ds5] {msg}", flush=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dump", action="store_true",
                    help="print decoded effects, do not drive the Apex 5")
    ap.add_argument("--quiet", action="store_true")
    ap.add_argument("--no-motion", action="store_true",
                    help="do not enable the vendor motion stream (no gyro)")
    ap.add_argument("--gyro-scale", type=float, default=1.0,
                    help="scale factor applied to gyro values; tune by feel")
    registry.add_device_argument(
        ap, help="which pad to relay, on a desk with more than one. It pins both\n                 halves -- the input node and the vendor node -- to one physical\n                 device, since two Apex 5s are identical to every other filter")
    ap.add_argument("--accel-scale", type=float, default=motion.ACCEL_SCALE,
                    help=f"scale factor applied to accelerometer values "
                         f"(default {motion.ACCEL_SCALE:.3f}, derived from the "
                         f"DualSense calibration we advertise)")
    args = ap.parse_args()

    # Turn SIGTERM into the same clean shutdown as Ctrl-C. Without this, being
    # killed leaves the controller streaming raw data and any trigger effect
    # still applied, because the cleanup below never runs.
    def _terminate(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)

    # The pad, held loosely: it leaves the USB bus every time it falls asleep,
    # and the virtual DualSense must not leave with it. See
    # `flydigi.relay.PadLink`.
    pad = relay.PadLink(want_ctrl=not args.dump, want_motion=not args.no_motion,
                        log=log, pad=args.device)
    connected, problem = pad.open()
    if not connected:
        sys.exit(problem)
    log(f"input: {pad.name} ({pad.reader.path})")
    if pad.ctrl is not None:
        log(f"controller: {pad.ctrl.path}")
    elif problem:
        log(problem)
    if pad.ctrl is not None and not args.no_motion:
        log(f"motion stream: {'enabled' if pad.motion_on else 'FAILED to enable'}")

    # Descriptor and feature reports come from ds5_usb.py, captured off real
    # hardware, rather than from inputtino. inputtino's descriptor is 273 bytes
    # against the hardware's 289 -- it stops short of feature reports 0x0B and
    # 0x0C -- and its calibration and firmware blobs belong to a different unit
    # of a different vintage.
    #
    # uhid replies to UHID_GET_REPORT with the payload verbatim, and a numbered
    # report's reply includes its id, so prepend it: ds5_usb stores bodies
    # without one precisely so that whoever serves them adds it exactly once.
    virtual = uhid.Device(
        "Wireless Controller", ds5_usb.VENDOR_ID, ds5_usb.PRODUCT_ID,
        ds5_usb.REPORT_DESC,
        bus=uhid.BUS_USB, version=0x8111,
        feature_reports={rid: bytes([rid]) + body
                         for rid, body in ds5_usb.FEATURE_REPORTS.items()})
    log("virtual DualSense created")
    log(f"games: set {dsmode.IGNORE_DEVICES}")

    state = ds5.InputState()
    applied = {}
    # The last payload actually sent per trigger. The pad discards live trigger
    # effects when it sleeps, and a game that set one has no reason to set it
    # again, so this is what gets sent when the pad comes back.
    last_effect = {}
    last_rumble = None
    left_motor = 0      # Flydigi stashes this and reuses it for one left case
    frames = 0
    motion_frames = 0
    last_info = None
    next_info_poll = 0.0

    def watched():
        return pad.fds() + [virtual.fd]

    def send_effects():
        """Push the remembered trigger effects at the pad, if there is one."""
        ctrl = pad.ctrl
        if ctrl is None:
            return
        for payload in last_effect.values():
            try:
                ctrl.send(payload, wait=0.0)
            except OSError:
                pad.broken = True

    try:
        relay.build_state(pad.reader, state)
        virtual.send_input(state.pack())
        watch = watched()
        while True:
            # Notice the pad leaving or returning before selecting on its
            # descriptors. The virtual pad stays either way -- a game that
            # loses it does not simply re-bind.
            if pad.poll():
                watch = watched()
                if pad.connected:
                    relay.build_state(pad.reader, state)
                    send_effects()
                else:
                    # Let go of everything: a pad that vanished mid-press
                    # would otherwise leave the game holding that button.
                    relay.release(state)
                    last_rumble = None
                virtual.send_input(state.pack())

            ready, _, _ = select.select(watch, [], [], 1.0)
            ctrl = pad.ctrl
            if pad.motion_on and ctrl is not None and ctrl.fd in ready:
                # Motion arrives at ~300 Hz, far faster than evdev events.
                # Fold it into the state and emit, so aiming stays smooth
                # rather than only updating when a stick moves.
                report = pad.read_motion()
                if report and report[0] == "motion":
                    _kind, gyro, accel = report
                    state.gyro = [v * args.gyro_scale for v in gyro]
                    state.accel = [v * args.accel_scale for v in accel]
                    state.sensor_timestamp += 188  # ~0.33us units at 300 Hz
                    virtual.send_input(state.pack())
                    motion_frames += 1
                elif report and report[0] == "info":
                    info = report[1]
                    level = info["battery_level"]
                    if info["charging"]:
                        state.battery_status = ds5.BATTERY_CHARGING
                        state.battery_charge = 10
                    else:
                        # Flydigi reports 0..5; DualSense wants 0..10.
                        state.battery_charge = min(10, level * 2)
                        state.battery_status = (
                            ds5.BATTERY_FULL if level >= motion.MAX_LEVEL
                            else ds5.BATTERY_DISCHARGING)
                    if info != last_info:
                        last_info = info
                        log(f"battery {level}/5"
                            f"{' (charging)' if info['charging'] else ''}"
                            f", {info['connect_type']}")
            if pad.motion_on and time.time() >= next_info_poll:
                # Battery only changes slowly; poll rarely.
                next_info_poll = time.time() + 30.0
                pad.request_info()
            reader = pad.reader
            if reader is not None and reader.fileno() in ready:
                if pad.read_input():
                    relay.build_state(reader, state)
                    virtual.send_input(state.pack())
                    frames += 1
            if virtual.fd in ready:
                for _rtype, data in virtual.poll(0.0):
                    parsed = ds5.parse_output(data)
                    rumble = parsed["rumble"]
                    if rumble:
                        left_motor = rumble[0]
                    if rumble and rumble != last_rumble:
                        last_rumble = rumble
                        if not args.quiet:
                            log(f"rumble {rumble}")
                        if ctrl is not None:
                            # wait=0 is mandatory here: the default 0.1
                            # spends 100 ms per update waiting for an ACK
                            # that carries nothing, on the loop that feeds
                            # the virtual pad.
                            try:
                                effects.rumble(ctrl, rumble[0], rumble[1],
                                               wait=0.0)
                            except OSError:
                                pad.broken = True
                    # See tools/flydigi-ds5-usbip: a pad with no force triggers
                    # would acknowledge these and do nothing. Input, rumble and
                    # motion are the same on both pads and keep running.
                    for effect in (parsed["effects"] if pad.has_triggers else ()):
                        if applied.get(effect.side) == effect.key():
                            continue
                        applied[effect.side] = effect.key()
                        mapped = relay.translate(effect, left_motor)
                        if mapped is None:
                            # Unrecognised effect: leave the trigger alone,
                            # as Flydigi does. Logged so unmapped patterns
                            # from new games are visible.
                            if not args.quiet:
                                log(f"{effect} -> unmapped, trigger unchanged")
                            continue
                        side, mode, params = mapped
                        if not args.quiet:
                            log(f"{effect} -> mode={mode} params={params}")
                        # Remembered whether or not it can be sent now: an
                        # effect set while the pad is asleep is exactly the
                        # one that has to be waiting for it when it wakes.
                        last_effect[effect.side] = effects.common_effect_payload(
                            side, mode, params)
                        if ctrl is not None:
                            try:
                                ctrl.send(last_effect[effect.side], wait=0.0)
                            except OSError:
                                pad.broken = True
    except KeyboardInterrupt:
        log(f"stopping after {frames} input frames, {motion_frames} motion "
            f"frames, {pad.drops} pad disconnections ridden out")
    finally:
        virtual.destroy()
        pad.close()


if __name__ == "__main__":
    main()
