sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import device, gpa6, gpa6_config, gpa6_profile, gpa6_haptics, gpa6_macros, gpa6_gyro, identity, mapping, registry, waveform
from flydigi import gpa6_backup


def action_target(text):
    """Gamepad shorthand, layer shortcuts, or a native target JSON object."""
    if text.startswith("{"):
        target = json.loads(text)
    elif text.startswith(("layer-hold:", "layer-toggle:")):
        kind, value = text.split(":", 1)
        target = {"type": kind.replace("-", "_"), "layer_id": int(value)}
    else:
        target = text
    gpa6_profile.encode_target(target)
    return target


def open_selected(selector):
    expected_uid = None
    if not selector:
        entries = [e for e in registry.list_pads(deep=True)
                   if e.get("code") == "k6" and e.get("uid") and not e.get("error")]
        if not entries:
            raise device.DeviceNotFound("no Apex 6 found; use FLYDIGI_MOCK_BUS=pad:k6 to emulate")
        if len(entries) > 1:
            raise registry.Ambiguous("multiple Apex 6 pads found; select one with --device")
        expected_uid = entries[0]["uid"]
        selector = entries[0]["path"]
    elif registry._node_selector(selector) is None:
        entry = registry.find(selector, registry.KIND_PAD, deep=True)
        expected_uid = entry.get("uid")
        if not expected_uid:
            raise identity.WrongDevice("selected controller did not report a UUID")
        selector = entry["path"]
    ctrl = registry.open_pad(selector)
    try:
        identity.require(ctrl, "k6")
        if expected_uid is not None and gpa6.Protocol(ctrl).uid() != expected_uid:
            raise identity.WrongDevice("selected UUID changed while opening the device")
        return ctrl
    except BaseException:
        ctrl.close()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    registry.add_device_argument(parser)
    parser.add_argument("--experimental", action="store_true", help="enable Apex 6 configuration writes or grip output")
    parser.add_argument("--reconnect", action="store_true", help="resume only the same UUID after unplug/sleep")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("info", help="read identity, capabilities and format versions")
    sub.add_parser("settings", help="read global controller settings")
    sub.add_parser("profile", help="read active profile buttons, timings and response curves")
    gyro = sub.add_parser("gyro", help="read or edit profile-wide gyro configuration")
    gyro.add_argument("target", nargs="?", choices=("off", "left", "right", "mouse"),
                      help="target changes select the web's default curve for that target")
    gyro.add_argument("--enable", choices=("hold", "click", "toggle"), help="click/toggle toggles activation")
    gyro.add_argument("--key", choices=tuple(gpa6_gyro.KEYS), help="primary activation button")
    gyro.add_argument("--key2", choices=(*gpa6_gyro.KEYS, "none"), help="secondary activation button; none removes it")
    for flag in ("invert-x", "invert-y"):
        gyro.add_argument("--" + flag, choices=("on", "off"))
    gyro.add_argument("--mouse-window-radius", type=int, help="mouse deadzone, native 0..255 scale")
    gyro.add_argument("--curve-start", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output start, 0..255")
    gyro.add_argument("--curve-end", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output end, 0..255")
    gyro_points = gyro.add_mutually_exclusive_group()
    gyro_points.add_argument("--point", type=int, nargs=2, action="append", metavar=("X", "Y"), help="replace up to two midpoints, 0..255")
    gyro_points.add_argument("--clear-points", action="store_true")
    gyro.add_argument("--save", action="store_true", help="also explicitly save; edits may already persist")
    macros = sub.add_parser("macros", help="list macro definitions in one layer")
    macros.add_argument("--layer", type=int, choices=range(4), default=0)
    macro = sub.add_parser("macro", help="read, create, edit or delete a native macro definition")
    macro.add_argument("id", type=int, choices=range(256), metavar="ID")
    macro.add_argument("--layer", type=int, choices=range(4), default=0)
    body = macro.add_mutually_exclusive_group()
    body.add_argument("--step", nargs=3, action="append", metavar=("DELAY_MS", "EVENT", "TARGET"),
                      help="replace steps; repeat up to 32 times; EVENT is press/release, TARGET is a button or native JSON")
    body.add_argument("--steps-file", help="JSON list of delay/event/key-or-target steps, using the existing recorder format")
    body.add_argument("--empty", action="store_true", help="create an empty macro or clear its steps")
    body.add_argument("--copy-from", type=int, choices=range(256), metavar="ID", help="copy a definition in this layer to a new ID")
    body.add_argument("--clear", action="store_true", help="delete the macro and its same-layer button/zone bindings")
    macro.add_argument("--mode", choices=gpa6_macros.MODES)
    macro.add_argument("--interval", type=int, help="repeat interval in milliseconds, 0..10000")
    macro.add_argument("--name", help="v1.9 macro name; an empty string clears it")
    macro.add_argument("--bind", choices=tuple(gpa6_profile.BUTTONS), help="replace this button's activators with the macro binding")
    macro.add_argument("--save", action="store_true", help="also explicitly save; edits may already persist")
    vibration = sub.add_parser("vibration", help="read/edit native grip vibration or trigger-bound feedback")
    vibration.add_argument("target", choices=("grips", "left", "right"), nargs="?")
    vibration.add_argument("--enabled", choices=("on", "off"))
    vibration.add_argument("--level", type=int, choices=range(1, 6))
    vibration.add_argument("--save", action="store_true", help="also explicitly save; edits may already persist")
    vibration_test = sub.add_parser("vibration-test", help="hold either trigger to test ordinary rumble; Ctrl-C stops")
    vibration_test.add_argument("--duration", type=float, default=60, help="maximum test time in seconds (default 60)")
    scene = sub.add_parser("trigger-scene", help="read/select native trigger haptic scenes")
    scene.add_argument("side", choices=("left", "right", "both"), nargs="?", default="both")
    scene.add_argument("--scene", choices=("normal", *gpa6_haptics.SCENES),
                       help="normal resets selected base trigger curves/zones when leaving haptics, like web Pro mode")
    scene.add_argument("--travel", type=int, choices=range(1, 4))
    scene.add_argument("--frequency", type=int, choices=range(1, 4), help="looping scenes only")
    scene.add_argument("--save", action="store_true")
    setting = sub.add_parser("set-setting", help="apply and verify one global setting")
    setting.add_argument("name", choices=tuple(gpa6_config.GLOBAL_FIELDS))
    setting.add_argument("value", help="integer, or on/off for a switch")
    slot = sub.add_parser("slot", help="select a profile; unsaved RAM edits are retained")
    slot.add_argument("number", type=int, choices=range(1, 5))
    sub.add_parser("save", help="save the active profile's current settings")
    remap = sub.add_parser("map", help="replace one button's activators with a simple button mapping")
    remap.add_argument("source", choices=tuple(gpa6_profile.BUTTONS))
    remap.add_argument("target", choices=(*gpa6_profile.BUTTONS, "default"))
    remap.add_argument("--layer", type=int, choices=range(4), default=0)
    remap.add_argument("--save", action="store_true", help="also send explicit profile save; applied edits may already persist")
    bind = sub.add_parser("bind", help="read or replace one button's full activator list")
    bind.add_argument("source", choices=tuple(gpa6_profile.BUTTONS))
    bind.add_argument("--layer", type=int, choices=range(4), default=0)
    actions = bind.add_mutually_exclusive_group()
    actions.add_argument("--action", nargs=2, action="append", metavar=("TYPE", "TARGET"),
                         help="repeat up to five times; TYPE: " + ", ".join(gpa6_profile.ACTIVATORS)
                         + "; TARGET: button/none, layer-hold:N, layer-toggle:N, or native target JSON")
    actions.add_argument("--clear", action="store_true", help="remove the override, restoring inherited/default behavior")
    bind.add_argument("--save", action="store_true")
    layer_add = sub.add_parser("layer-add", help="create an empty Shift layer if absent")
    layer_add.add_argument("number", type=int, choices=range(1, 4))
    layer_add.add_argument("--save", action="store_true")
    timing = sub.add_parser("timing", help="set profile long/double-press timing in milliseconds")
    timing.add_argument("--long-ms", type=int)
    timing.add_argument("--double-ms", type=int)
    timing.add_argument("--save", action="store_true")
    for command in ("trigger-zones", "stick-zones"):
        zones = sub.add_parser(command, help="read or replace one control's action zones")
        zones.add_argument("side", choices=("left", "right"))
        zones.add_argument("--layer", type=int, choices=range(4), default=0)
        changes = zones.add_mutually_exclusive_group()
        fields = ("DIR", "START", "STOP", "TARGET") if command == "stick-zones" else ("START", "STOP", "TARGET")
        changes.add_argument("--zone", nargs=len(fields), action="append", metavar=fields,
                             help="replace all zones; repeat up to " + ("eight" if command == "stick-zones" else "four")
                             + " times; ranges use 0..255; targets match bind")
        changes.add_argument("--clear", action="store_true", help="remove this side/layer's zone section")
        zones.add_argument("--save", action="store_true")
        if command == "stick-zones":
            zones.add_argument("--mode", choices=gpa6_profile.ANGLE_MODES, help="preserve existing angle mode by default; new sections use 4way")
    for command in ("stick", "trigger"):
        response = sub.add_parser(command, help=f"read or edit one {command}'s response")
        response.add_argument("side", choices=("left", "right"))
        response.add_argument("--curve-start", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output start, 0..255")
        response.add_argument("--curve-end", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output end, 0..255")
        response.add_argument("--point", type=int, nargs=2, action="append", metavar=("X", "Y"), help="replace midpoints; repeat at most twice, 0..255")
        response.add_argument("--clear-points", action="store_true")
        response.add_argument("--save", action="store_true")
        if command == "stick":
            response.add_argument("--preset", choices=("default", "instant", "delay", "custom"), help="shared curve presets; custom keeps the current shape")
            response.add_argument("--center", type=int, help="inner deadzone, 0..100 percent")
            response.add_argument("--edge", type=int, help="outer deadzone, 0..100 percent")
            for flag in ("circular", "invert-x", "invert-y"):
                response.add_argument("--" + flag, choices=("on", "off"))
        else:
            response.add_argument("--zero", type=int, help="start of linear travel window, 0..255")
            response.add_argument("--end", type=int, help="end of linear travel window, 0..255")
    light = sub.add_parser("light", help="read or edit the active profile's lighting")
    light.add_argument("--mode", choices=("off", "solid", "breathing", "gradient", "streaming", "default"))
    light.add_argument("--color", nargs="+", help="RRGGBB color(s), up to eight")
    light.add_argument("--brightness", type=int)
    light.add_argument("--speed", type=int)
    light.add_argument("--vibration", choices=("on", "off"))
    light.add_argument("--save", action="store_true")
    snapshot = sub.add_parser("snapshot", help="export active RAM to a new JSON file (no restore support)")
    snapshot.add_argument("output", help="new snapshot file; existing files are never overwritten")
    backup = sub.add_parser("backup", help="export a restorable active-profile package")
    backup.add_argument("output", help="new JSON file; existing files are never overwritten")
    backup.add_argument("--name", help="local profile name")
    restore = sub.add_parser("restore", help="restore a profile package to the active slot")
    restore.add_argument("input")
    restore.add_argument("--save", action="store_true", help="also explicitly save; writes may already persist")
    restore.add_argument("--slot", type=int, choices=range(4), help="require this active slot (0..3); never switches slots")
    restore.add_argument("--directory", help="library directory for the automatic recovery copy")
    library = sub.add_parser("library", help="local named profile packages (offline except backup/restore)")
    library.add_argument("--directory", help="defaults to $XDG_DATA_HOME/openflydigi/apex6/profiles")
    library_sub = library.add_subparsers(dest="library_command", required=True)
    library_sub.add_parser("list", help="list profiles and any invalid entries")
    for command in ("show", "remove", "export", "restore"):
        item = library_sub.add_parser(command)
        item.add_argument("id", help="library entry ID from list")
        if command == "export":
            item.add_argument("output", help="new JSON file")
        elif command == "restore":
            item.add_argument("--save", action="store_true")
            item.add_argument("--slot", type=int, choices=range(4), help="require this active slot; never switches slots")
    for command in ("import", "backup"):
        item = library_sub.add_parser(command)
        if command == "import":
            item.add_argument("input")
        item.add_argument("--name", help="local profile name")
    tone = sub.add_parser("tone", help="play a quiet stereo test tone")
    tone.add_argument("--duration", type=float, default=2)
    tone.add_argument("--left", type=float, default=80, help="left frequency in Hz; 0 disables")
    tone.add_argument("--right", type=float, default=120, help="right frequency in Hz; 0 disables")
    tone.add_argument("--amplitude", type=float, default=0.15)
    play = sub.add_parser("play", help="play 48 kHz s16 PCM WAV; stereo or four-channel DualSense capture")
    play.add_argument("wav")
    args = parser.parse_args()
    gyro_write = args.command == "gyro" and (any(getattr(args, key) is not None for key in (
        "target", "enable", "key", "key2", "invert_x", "invert_y", "mouse_window_radius",
        "curve_start", "curve_end", "point")) or args.clear_points or args.save)
    macro_write = args.command == "macro" and (any(getattr(args, key) is not None
        for key in ("step", "steps_file", "copy_from", "mode", "interval", "name", "bind")) or args.empty or args.clear or args.save)
    if args.command == "macro" and args.clear and any(getattr(args, key) is not None for key in ("mode", "interval", "name", "bind")):
        parser.error("--clear cannot be combined with macro edits or --bind")
    vibration_write = args.command == "vibration" and (args.enabled is not None or args.level is not None or args.save)
    scene_write = args.command == "trigger-scene" and (args.scene is not None or args.travel is not None or args.frequency is not None or args.save)
    if vibration_write and args.target is None:
        parser.error("vibration edits require grips, left or right")
    zone_command = args.command in ("trigger-zones", "stick-zones")
    zone_write = False
    if zone_command:
        zone_mode = getattr(args, "mode", None)
        zone_write = args.zone is not None or args.clear or args.save or zone_mode is not None
        if args.clear and zone_mode is not None:
            parser.error("--clear and --mode cannot be combined")
        zone_values = None
        if args.zone is not None:
            try:
                maximum = 8 if args.command == "stick-zones" else 4
                if len(args.zone) > maximum:
                    raise ValueError(f"at most {maximum} zones are supported")
                zone_values = []
                for parts in args.zone:
                    low, high, target = parts[-3:]
                    low, high = int(low), int(high)
                    if not 0 <= low <= high <= 255:
                        raise ValueError("zone ranges require 0 <= START <= STOP <= 255")
                    zone = {"start": low, "stop": high, "target": action_target(target)}
                    if args.command == "stick-zones":
                        if parts[0] not in gpa6_profile.DIRECTIONS:
                            raise ValueError("unknown stick direction: " + parts[0])
                        zone["dir"] = parts[0]
                    zone_values.append(zone)
            except ValueError as exc:
                parser.error(str(exc))
    bind_write = args.command == "bind" and (args.action is not None or args.clear or args.save)
    if args.command == "bind":
        try:
            if args.action and len(args.action) > 5:
                raise ValueError("a button supports at most five activators")
            bindings = []
            for kind, target in args.action or ():
                if kind not in gpa6_profile.ACTIVATORS:
                    raise ValueError("unknown activator type: " + kind)
                bindings.append({"type": kind, "target": action_target(target)})
        except ValueError as exc:
            parser.error(str(exc))
    light_write = args.command == "light" and any(
        getattr(args, key) is not None for key in ("mode", "color", "brightness", "speed", "vibration"))
    response_command = args.command in ("stick", "trigger")
    response_write = False
    if response_command:
        native = any(getattr(args, key) is not None for key in ("curve_start", "curve_end", "point")) or args.clear_points
        facade = ("preset", "center", "edge") if args.command == "stick" else ("zero", "end")
        facade_write = any(getattr(args, key) is not None for key in facade)
        response_write = native or facade_write or (args.command == "stick" and any(
            getattr(args, key) is not None for key in ("circular", "invert_x", "invert_y")))
        if args.point and args.clear_points:
            parser.error("--point and --clear-points cannot be combined")
        if native and facade_write:
            parser.error("edit either exact curve coordinates or preset/deadzone/travel controls in one command")
    library_restore = args.command == "library" and args.library_command == "restore"
    if (args.command in ("tone", "play", "set-setting", "map", "timing", "slot", "save", "layer-add", "vibration-test", "restore")
            or library_restore
            or light_write or response_write or bind_write or zone_write or vibration_write or scene_write or macro_write or gyro_write
            or ((args.command == "light" or response_command) and args.save)) and not args.experimental:
        parser.error("configuration writes and grip output require --experimental")
    if args.command == "vibration-test" and (not math.isfinite(args.duration) or not 0 < args.duration <= 3600):
        parser.error("vibration-test duration must be in (0,3600]")
    if args.command == "timing" and args.long_ms is None and args.double_ms is None:
        parser.error("provide --long-ms and/or --double-ms")
    if args.command == "tone":
        values = (args.duration, args.left, args.right, args.amplitude)
        if (not all(math.isfinite(x) for x in values) or not 0 < args.duration <= 3600
                or not 0 <= args.left <= 300 or not 0 <= args.right <= 300
                or not 0 <= args.amplitude <= 1):
            parser.error("use a duration in (0,3600], frequencies in [0,300] and amplitude in [0,1]")
    source = None
    ctrl = session = None
    try:
        profile_to_restore = None
        if args.command in ("library", "restore"):
            profile_library = gpa6_backup.Library(args.directory)
            if args.command == "restore":
                profile_to_restore = gpa6_backup.load_config(args.input)
            else:
                command = args.library_command
                if command == "list":
                    print(json.dumps(profile_library.list(), indent=2, ensure_ascii=False))
                    return 0
                if command == "show":
                    print(gpa6_backup.pack_config(profile_library.get(args.id)).decode(), end="")
                    return 0
                if command == "import":
                    print(json.dumps({"id": profile_library.import_file(args.input, name=args.name)}))
                    return 0
                if command == "export":
                    profile_library.export(args.id, args.output)
                    print(json.dumps({"exported": args.output}))
                    return 0
                if command == "remove":
                    profile_library.remove(args.id)
                    print(json.dumps({"removed": args.id}))
                    return 0
                if command == "restore":
                    profile_to_restore = profile_library.get(args.id)
        macro_steps = None
        if args.command == "macro":
            if args.steps_file is not None:
                with open(args.steps_file, encoding="utf-8") as stream:
                    macro_steps = json.load(stream)
                if not isinstance(macro_steps, list):
                    raise ValueError("macro steps file must contain a JSON list")
            elif args.empty:
                macro_steps = []
            elif args.step is not None:
                macro_steps = []
                for delay, event, target in args.step:
                    if event not in ("press", "release"):
                        raise ValueError("macro step event must be press or release")
                    step = {"delay": int(delay), "event": mapping.MACRO_PRESS if event == "press" else mapping.MACRO_RELEASE}
                    step["target" if target.startswith("{") else "key"] = json.loads(target) if target.startswith("{") else target
                    macro_steps.append(step)
        if args.command in ("snapshot", "backup") and os.path.lexists(args.output):
            raise FileExistsError(f"output already exists: {args.output}")
        channels = 2
        if args.command == "play":
            source = wave.open(args.wav, "rb")
            channels = source.getnchannels()
            if source.getframerate() != 48000 or source.getsampwidth() != 2 or channels not in (2, 4):
                raise ValueError("WAV must be 48 kHz, signed 16-bit PCM, with 2 or 4 channels")
            duration = source.getnframes() / 48000
        elif args.command == "tone":
            duration = args.duration
        ctrl = open_selected(args.device)
        protocol = gpa6.Protocol(ctrl)
        uid = protocol.uid()
        if args.command == "backup" or (args.command == "library" and args.library_command == "backup"):
            config = gpa6_backup.read_config(ctrl, name=args.name, expected_uid=uid)
            if args.command == "backup":
                gpa6_backup.export_config(args.output, config)
                print(json.dumps({"exported": args.output, **config.describe()}, indent=2, ensure_ascii=False))
            else:
                print(json.dumps({"id": profile_library.add(config), **config.describe()}, indent=2, ensure_ascii=False))
            return 0
        if profile_to_restore is not None:
            recovery = []
            def backup_before(config):
                entry_id = profile_library.add(config, name=f"Before restore — profile {config.cfg_id + 1}")
                recovery.append(entry_id)
                print(f"Recovery profile: {profile_library.directory / (entry_id + '.json')}", file=sys.stderr, flush=True)
            result = gpa6_backup.write_config(ctrl, profile_to_restore, save=args.save,
                expected_uid=uid, expected_slot=args.slot, before_write=backup_before)
            print(json.dumps({"restored_slot": result.cfg_id, "name": result.name,
                              "recovery_ids": recovery, "saved": args.save}, indent=2, ensure_ascii=False))
            return 0
        if args.command == "gyro":
            def edit_gyro(data):
                config = gpa6_profile.MappingConfig(data)
                keys = None
                if args.key is not None or args.key2 is not None:
                    first, second = config.motion()["keys"]
                    keys = (args.key if args.key is not None else first,
                            second if args.key2 is None else None if args.key2 == "none" else args.key2)
                target = {"left": "left stick", "right": "right stick"}.get(args.target, args.target)
                config.set_motion(target=target, enable_type="click" if args.enable == "toggle" else args.enable,
                    keys=keys, mouse_window_radius=args.mouse_window_radius,
                    **{key: None if getattr(args, key) is None else getattr(args, key) == "on"
                       for key in ("invert_x", "invert_y")})
                config.set_motion_curve(start=args.curve_start, end=args.curve_end,
                                        points=[] if args.clear_points else args.point)
                return config.blob
            data = (gpa6_config.edit_ram(ctrl, 5, edit_gyro, save=args.save, expected_uid=uid)
                    if gyro_write else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            if gyro_write:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps({**config.motion(), "curve": config.motion_curve()}, indent=2))
            return 0
        if args.command in ("macros", "macro"):
            def edit_macro(data):
                config = gpa6_profile.MappingConfig(data)
                if args.clear:
                    config.clear_macro(args.id, layer=args.layer)
                else:
                    steps, mode, interval, name = macro_steps, args.mode, args.interval, args.name
                    if args.copy_from is not None:
                        original = config.macro(args.copy_from, layer=args.layer)
                        if original is None:
                            raise ValueError("source macro does not exist")
                        if config.macro(args.id, layer=args.layer) is not None:
                            raise ValueError("copy destination macro already exists")
                        steps = original["steps"]
                        mode = mode if mode is not None else original["type"]
                        interval = interval if interval is not None else original["interval"]
                        name = name if name is not None else original["name"]
                    if steps is not None or any(value is not None for value in (mode, interval, name)):
                        config.set_macro(args.id, steps, mode, interval, name, layer=args.layer)
                    if args.bind is not None:
                        config.set_activators(args.bind, [{"type": "simple", "target": {"type": "macro", "macro_id": args.id}}], layer=args.layer)
                return config.blob
            data = (gpa6_config.edit_ram(ctrl, 5, edit_macro, save=args.save, expected_uid=uid)
                    if macro_write else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = config.macros(layer=args.layer) if args.command == "macros" else config.macro(args.id, layer=args.layer)
            if macro_write:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2, ensure_ascii=False))
            return 0
        if args.command == "trigger-scene":
            if scene_write:
                config = gpa6_haptics.edit(ctrl, lambda c: c.set_trigger_scene(args.side, args.scene,
                    travel=args.travel, frequency=args.frequency), save=args.save, expected_uid=uid)
            else:
                config = gpa6_haptics.read(ctrl, expected_uid=uid)
            print(json.dumps({s: config.trigger_scene(s) for s in (gpa6_haptics.SIDES if args.side == "both" else (args.side,))}, indent=2))
            return 0
        if args.command == "vibration-test":
            with gpa6_haptics.VibrationTest(ctrl, expected_uid=uid) as test:
                print("Hold either trigger past 20% to request rumble. For trigger feedback, pull the trigger being tested. Release both to stop; Ctrl-C ends the test.", flush=True)
                stop = time.monotonic() + args.duration
                while time.monotonic() < stop:
                    test.tick()
                    time.sleep(.05)
            return 0
        if args.command == "vibration":
            if vibration_write:
                config = gpa6_haptics.edit(ctrl, lambda c: c.set_vibration(args.target,
                    enabled=None if args.enabled is None else args.enabled == "on", level=args.level),
                    save=args.save, expected_uid=uid)
            else:
                config = gpa6_haptics.read(ctrl, expected_uid=uid)
            print(json.dumps(config.vibration(args.target) if args.target else config.describe(), indent=2))
            return 0
        if args.command == "settings":
            print(json.dumps(gpa6_config.global_config(protocol.read_ram(1), protocol.versions()[0]), indent=2))
            return 0
        if args.command == "set-setting":
            boolean = type(gpa6_config.GLOBAL_FIELDS[args.name][2][0]) is bool
            if boolean:
                if args.value not in ("on", "off"):
                    raise ValueError("switch settings require on or off")
                value = args.value == "on"
            else:
                value = int(args.value)
            print(json.dumps(gpa6_config.set_setting(ctrl, args.name, value, expected_uid=uid), indent=2))
            return 0
        if args.command == "slot":
            protocol.select_slot(args.number - 1)
            print(f"Selected profile {args.number}")
            return 0
        if args.command == "save":
            slot = protocol.slot()
            protocol.save_slot(slot)
            print(f"Saved profile {slot + 1}")
            return 0
        if zone_command:
            def edit_zones(data):
                config = gpa6_profile.MappingConfig(data)
                values = [] if args.clear else zone_values
                if args.command == "trigger-zones":
                    config.trigger_zones(args.side, layer=args.layer)
                    if values is not None:
                        config.set_trigger_zones(args.side, values, layer=args.layer)
                else:
                    config.set_stick_zones(args.side, values, angle_mode=zone_mode, layer=args.layer)
                return config.blob
            data = (gpa6_config.edit_ram(ctrl, 5, edit_zones, save=args.save, expected_uid=uid)
                    if zone_write else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = (config.trigger_zones(args.side, layer=args.layer) if args.command == "trigger-zones"
                      else config.stick_zones(args.side, layer=args.layer))
            if zone_write:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2))
            return 0
        if args.command in ("bind", "layer-add"):
            def edit_bindings(data):
                config = gpa6_profile.MappingConfig(data)
                if args.command == "layer-add":
                    config.ensure_layer(args.number)
                elif args.action is not None or args.clear:
                    config.set_activators(args.source, None if args.clear else bindings, layer=args.layer)
                return config.blob
            writing = bind_write or args.command == "layer-add"
            data = (gpa6_config.edit_ram(ctrl, 5, edit_bindings, save=args.save, expected_uid=uid)
                    if writing else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = ({"source": args.source, "layer": args.layer,
                       "activators": config.activators(args.source, layer=args.layer)}
                      if args.command == "bind" else {"layers": config.layer_ids()})
            if writing:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2))
            return 0
        if response_command:
            def edit_response(data):
                config = gpa6_profile.MappingConfig(data)
                if args.command == "stick":
                    flags = {key: None if getattr(args, key) is None else getattr(args, key) == "on"
                             for key in ("circular", "invert_x", "invert_y")}
                    preset = ("default", "instant", "delay", "custom").index(args.preset) if args.preset else None
                    config.set_stick(args.side, curve_type=preset, center=args.center, edge=args.edge, **flags)
                else:
                    config.set_trigger_curve(args.side, zero=args.zero, end=args.end)
                config.set_response_curve(args.command, args.side, start=args.curve_start,
                    end=args.curve_end, points=[] if args.clear_points else args.point)
                return config.blob
            data = (gpa6_config.edit_ram(ctrl, 5, edit_response, save=args.save, expected_uid=uid)
                    if response_write or args.save else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = config.stick(args.side) if args.command == "stick" else config.trigger_curve(args.side)
            if response_write or args.save:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2))
            return 0
        if args.command in ("profile", "map", "timing"):
            if args.command == "profile":
                data = protocol.read_ram(5)
            else:
                transform = (lambda data: gpa6_profile.remap(data, args.source, args.target, layer=args.layer)) if args.command == "map" else (
                    lambda data: gpa6_profile.timing(data, long_ms=args.long_ms, double_ms=args.double_ms))
                data = gpa6_config.edit_ram(ctrl, 5, transform, save=args.save, expected_uid=uid)
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(gpa6_profile.describe(data), indent=2))
            return 0
        if args.command == "light":
            def edit_light(data):
                current = gpa6_config.lighting_config(data)
                modes = ("off", "solid", "breathing", "gradient", "streaming", "default")
                mode = modes.index(args.mode) if args.mode else current["base"]["mode"]
                values = current["base"].get("config") or {}
                brightness = args.brightness if args.brightness is not None else values.get("brightness", 50)
                speed = args.speed if args.speed is not None else values.get("speed", 50)
                colors = values.get("colors", [values.get("color", {"r": 255, "g": 255, "b": 255})])
                if args.color:
                    colors = []
                    for color in args.color:
                        if len(color) != 6 or any(c not in "0123456789abcdefABCDEF" for c in color):
                            raise ValueError("colors must be six hexadecimal digits")
                        colors.append(dict(zip(("r", "g", "b"), bytes.fromhex(color))))
                if mode == 1 and len(colors) != 1:
                    raise ValueError("solid lighting requires one color")
                config = (None if mode == 0 else {"color": colors[0], "brightness": brightness} if mode == 1
                          else {"colors": colors, "brightness": brightness, "speed": speed} if mode in (2, 3)
                          else {"brightness": brightness, "speed": speed})
                return gpa6_config.encode_lighting({"base": {"mode": mode, "config": config},
                    "vibration": current["vibration"] if args.vibration is None else args.vibration == "on"})
            data = (gpa6_config.edit_ram(ctrl, 4, edit_light, save=args.save, expected_uid=uid)
                    if light_write else protocol.read_ram(4))
            if args.save and not light_write:
                protocol.save_slot(protocol.slot())
            if light_write or args.save:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(gpa6_config.lighting_config(data), indent=2))
            return 0
        if args.command == "info":
            print(json.dumps({"uid": uid, "info": protocol.info(),
                              "format_versions": protocol.versions(),
                              "experimental": True, "mock": device.is_mock(ctrl.path)}, indent=2))
            return 0
        if args.command == "snapshot":
            data = gpa6_config.snapshot(ctrl, expected_uid=uid)
            data["mock"] = device.is_mock(ctrl.path)
            gpa6_config.write_snapshot(args.output, data)
            print(f"Saved active slot {data['active_slot'] + 1} RAM to {args.output}"
                  + (" [MOCK]" if data["mock"] else ""))
            for name, block in data["blocks"].items():
                if "decode_error" in block:
                    print(f"{name}: raw bytes retained; {block['decode_error']}", file=sys.stderr)
            return 0
        print(f"{identity.name_for(protocol.info()['device_type'])}: experimental grip output; "
              f"UUID {uid}" + (" [MOCK]" if device.is_mock(ctrl.path) else ""), file=sys.stderr)
        session = waveform.GripSession(ctrl, experimental=True, expected_uid=uid, channels=channels)
        session.start()
        start = time.monotonic()
        next_feed = start
        source_frame = 0
        while time.monotonic() - start < duration:
            now = time.monotonic()
            if session is None:
                try:
                    ctrl = open_selected("uid:" + uid)
                    session = waveform.GripSession(ctrl, experimental=True, expected_uid=uid, channels=channels)
                    session.start()
                    next_feed = now
                    source_frame = int((now - start) * 48000)
                except (OSError, device.DeviceNotFound, device.DeviceBusy, identity.WrongDevice, gpa6.ProtocolError):
                    if ctrl:
                        ctrl.close()
                    ctrl = session = None
                    time.sleep(0.25)
                    continue
            try:
                if now >= next_feed:
                    if now - next_feed > session.max_latency:
                        source_frame = int((now - start) * 48000)
                        next_feed = now
                    offset = source_frame
                    if source:
                        source.setpos(min(source.getnframes(), offset))
                        pcm = source.readframes(384)
                    else:
                        values = (round(32767 * args.amplitude * math.sin(2 * math.pi * hz * (offset + i) / 48000))
                                  for i in range(min(384, max(0, int(duration * 48000) - offset)))
                                  for hz in (args.left, args.right))
                        values = list(values)
                        pcm = struct.pack("<" + "h" * len(values), *values)
                    session.feed(pcm, now)
                    source_frame += 384
                    next_feed += waveform.PERIOD
                session.tick(now)
            except (OSError, gpa6.ReplyTimeout, waveform.ProfileChanged) as exc:
                if not args.reconnect:
                    raise
                print(f"{exc}; waiting for UUID {uid}", file=sys.stderr)
                try:
                    session.stop()
                except (OSError, gpa6.ProtocolError):
                    pass
                ctrl.close()
                ctrl = session = None
                continue
            time.sleep(max(0, min(next_feed, session.next_packet) - time.monotonic()))
        return 0
    finally:
        try:
            if session:
                session.stop()
        finally:
            if ctrl:
                ctrl.close()
            if source:
                source.close()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except (OSError, ValueError, wave.Error, identity.WrongDevice, device.DeviceNotFound, device.DeviceBusy) as exc:
        sys.exit(str(exc))
