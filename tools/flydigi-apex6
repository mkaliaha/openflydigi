"""Experimental Apex 6 / 6 Pro settings, profiles, snapshots and grip output."""
import argparse
import json
import math
import os
import signal
import struct
import sys
import time
import wave

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import device, gpa6, gpa6_config, gpa6_profile, identity, registry, waveform


def action_target(text):
    """Gamepad shorthand, layer shortcuts, or a native target JSON object."""
    if text.startswith("{"):
        target = json.loads(text)
    elif text.startswith(("layer-hold:", "layer-toggle:")):
        kind, value = text.split(":", 1)
        target = {"type": kind.replace("-", "_"), "layer_id": int(value)}
    else:
        target = text
    gpa6_profile.encode_target(target)
    return target


def open_selected(selector):
    expected_uid = None
    if not selector:
        entries = [e for e in registry.list_pads(deep=True)
                   if e.get("code") == "k6" and e.get("uid") and not e.get("error")]
        if not entries:
            raise device.DeviceNotFound("no Apex 6 found; use FLYDIGI_MOCK_BUS=pad:k6 to emulate")
        if len(entries) > 1:
            raise registry.Ambiguous("multiple Apex 6 pads found; select one with --device")
        expected_uid = entries[0]["uid"]
        selector = entries[0]["path"]
    elif registry._node_selector(selector) is None:
        entry = registry.find(selector, registry.KIND_PAD, deep=True)
        expected_uid = entry.get("uid")
        if not expected_uid:
            raise identity.WrongDevice("selected controller did not report a UUID")
        selector = entry["path"]
    ctrl = registry.open_pad(selector)
    try:
        identity.require(ctrl, "k6")
        if expected_uid is not None and gpa6.Protocol(ctrl).uid() != expected_uid:
            raise identity.WrongDevice("selected UUID changed while opening the device")
        return ctrl
    except BaseException:
        ctrl.close()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    registry.add_device_argument(parser)
    parser.add_argument("--experimental", action="store_true", help="enable Apex 6 configuration writes or grip output")
    parser.add_argument("--reconnect", action="store_true", help="resume only the same UUID after unplug/sleep")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("info", help="read identity, capabilities and format versions")
    sub.add_parser("settings", help="read global controller settings")
    sub.add_parser("profile", help="read active profile buttons, timings and response curves")
    setting = sub.add_parser("set-setting", help="apply and verify one global setting")
    setting.add_argument("name", choices=tuple(gpa6_config.GLOBAL_FIELDS))
    setting.add_argument("value", help="integer, or on/off for a switch")
    slot = sub.add_parser("slot", help="select a profile; unsaved RAM edits are retained")
    slot.add_argument("number", type=int, choices=range(1, 5))
    sub.add_parser("save", help="save the active profile's current settings")
    remap = sub.add_parser("map", help="replace one button's activators with a simple button mapping")
    remap.add_argument("source", choices=tuple(gpa6_profile.BUTTONS))
    remap.add_argument("target", choices=(*gpa6_profile.BUTTONS, "default"))
    remap.add_argument("--layer", type=int, choices=range(4), default=0)
    remap.add_argument("--save", action="store_true", help="also send explicit profile save; applied edits may already persist")
    bind = sub.add_parser("bind", help="read or replace one button's full activator list")
    bind.add_argument("source", choices=tuple(gpa6_profile.BUTTONS))
    bind.add_argument("--layer", type=int, choices=range(4), default=0)
    actions = bind.add_mutually_exclusive_group()
    actions.add_argument("--action", nargs=2, action="append", metavar=("TYPE", "TARGET"),
                         help="repeat up to five times; TYPE: " + ", ".join(gpa6_profile.ACTIVATORS)
                         + "; TARGET: button/none, layer-hold:N, layer-toggle:N, or native target JSON")
    actions.add_argument("--clear", action="store_true", help="remove the override, restoring inherited/default behavior")
    bind.add_argument("--save", action="store_true")
    layer_add = sub.add_parser("layer-add", help="create an empty Shift layer if absent")
    layer_add.add_argument("number", type=int, choices=range(1, 4))
    layer_add.add_argument("--save", action="store_true")
    timing = sub.add_parser("timing", help="set profile long/double-press timing in milliseconds")
    timing.add_argument("--long-ms", type=int)
    timing.add_argument("--double-ms", type=int)
    timing.add_argument("--save", action="store_true")
    for command in ("stick", "trigger"):
        response = sub.add_parser(command, help=f"read or edit one {command}'s response")
        response.add_argument("side", choices=("left", "right"))
        response.add_argument("--curve-start", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output start, 0..255")
        response.add_argument("--curve-end", type=int, nargs=2, metavar=("X", "Y"), help="absolute input/output end, 0..255")
        response.add_argument("--point", type=int, nargs=2, action="append", metavar=("X", "Y"), help="replace midpoints; repeat at most twice, 0..255")
        response.add_argument("--clear-points", action="store_true")
        response.add_argument("--save", action="store_true")
        if command == "stick":
            response.add_argument("--preset", choices=("default", "instant", "delay", "custom"), help="shared curve presets; custom keeps the current shape")
            response.add_argument("--center", type=int, help="inner deadzone, 0..100 percent")
            response.add_argument("--edge", type=int, help="outer deadzone, 0..100 percent")
            for flag in ("circular", "invert-x", "invert-y"):
                response.add_argument("--" + flag, choices=("on", "off"))
        else:
            response.add_argument("--zero", type=int, help="start of linear travel window, 0..255")
            response.add_argument("--end", type=int, help="end of linear travel window, 0..255")
    light = sub.add_parser("light", help="read or edit the active profile's lighting")
    light.add_argument("--mode", choices=("off", "solid", "breathing", "gradient", "streaming", "default"))
    light.add_argument("--color", nargs="+", help="RRGGBB color(s), up to eight")
    light.add_argument("--brightness", type=int)
    light.add_argument("--speed", type=int)
    light.add_argument("--vibration", choices=("on", "off"))
    light.add_argument("--save", action="store_true")
    snapshot = sub.add_parser("snapshot", help="export active RAM to a new JSON file (no restore support)")
    snapshot.add_argument("output", help="new snapshot file; existing files are never overwritten")
    tone = sub.add_parser("tone", help="play a quiet stereo test tone")
    tone.add_argument("--duration", type=float, default=2)
    tone.add_argument("--left", type=float, default=80, help="left frequency in Hz; 0 disables")
    tone.add_argument("--right", type=float, default=120, help="right frequency in Hz; 0 disables")
    tone.add_argument("--amplitude", type=float, default=0.15)
    play = sub.add_parser("play", help="play 48 kHz s16 PCM WAV; stereo or four-channel DualSense capture")
    play.add_argument("wav")
    args = parser.parse_args()
    bind_write = args.command == "bind" and (args.action is not None or args.clear or args.save)
    if args.command == "bind":
        try:
            if args.action and len(args.action) > 5:
                raise ValueError("a button supports at most five activators")
            bindings = []
            for kind, target in args.action or ():
                if kind not in gpa6_profile.ACTIVATORS:
                    raise ValueError("unknown activator type: " + kind)
                bindings.append({"type": kind, "target": action_target(target)})
        except ValueError as exc:
            parser.error(str(exc))
    light_write = args.command == "light" and any(
        getattr(args, key) is not None for key in ("mode", "color", "brightness", "speed", "vibration"))
    response_command = args.command in ("stick", "trigger")
    response_write = False
    if response_command:
        native = any(getattr(args, key) is not None for key in ("curve_start", "curve_end", "point")) or args.clear_points
        facade = ("preset", "center", "edge") if args.command == "stick" else ("zero", "end")
        facade_write = any(getattr(args, key) is not None for key in facade)
        response_write = native or facade_write or (args.command == "stick" and any(
            getattr(args, key) is not None for key in ("circular", "invert_x", "invert_y")))
        if args.point and args.clear_points:
            parser.error("--point and --clear-points cannot be combined")
        if native and facade_write:
            parser.error("edit either exact curve coordinates or preset/deadzone/travel controls in one command")
    if (args.command in ("tone", "play", "set-setting", "map", "timing", "slot", "save", "layer-add")
            or light_write or response_write or bind_write
            or ((args.command == "light" or response_command) and args.save)) and not args.experimental:
        parser.error("configuration writes and grip output require --experimental")
    if args.command == "timing" and args.long_ms is None and args.double_ms is None:
        parser.error("provide --long-ms and/or --double-ms")
    if args.command == "tone":
        values = (args.duration, args.left, args.right, args.amplitude)
        if (not all(math.isfinite(x) for x in values) or not 0 < args.duration <= 3600
                or not 0 <= args.left <= 300 or not 0 <= args.right <= 300
                or not 0 <= args.amplitude <= 1):
            parser.error("use a duration in (0,3600], frequencies in [0,300] and amplitude in [0,1]")
    source = None
    ctrl = session = None
    try:
        if args.command == "snapshot" and os.path.lexists(args.output):
            raise FileExistsError(f"snapshot already exists: {args.output}")
        channels = 2
        if args.command == "play":
            source = wave.open(args.wav, "rb")
            channels = source.getnchannels()
            if source.getframerate() != 48000 or source.getsampwidth() != 2 or channels not in (2, 4):
                raise ValueError("WAV must be 48 kHz, signed 16-bit PCM, with 2 or 4 channels")
            duration = source.getnframes() / 48000
        elif args.command == "tone":
            duration = args.duration
        ctrl = open_selected(args.device)
        protocol = gpa6.Protocol(ctrl)
        uid = protocol.uid()
        if args.command == "settings":
            print(json.dumps(gpa6_config.global_config(protocol.read_ram(1), protocol.versions()[0]), indent=2))
            return 0
        if args.command == "set-setting":
            boolean = type(gpa6_config.GLOBAL_FIELDS[args.name][2][0]) is bool
            if boolean:
                if args.value not in ("on", "off"):
                    raise ValueError("switch settings require on or off")
                value = args.value == "on"
            else:
                value = int(args.value)
            print(json.dumps(gpa6_config.set_setting(ctrl, args.name, value, expected_uid=uid), indent=2))
            return 0
        if args.command == "slot":
            protocol.select_slot(args.number - 1)
            print(f"Selected profile {args.number}")
            return 0
        if args.command == "save":
            slot = protocol.slot()
            protocol.save_slot(slot)
            print(f"Saved profile {slot + 1}")
            return 0
        if args.command in ("bind", "layer-add"):
            def edit_bindings(data):
                config = gpa6_profile.MappingConfig(data)
                if args.command == "layer-add":
                    config.ensure_layer(args.number)
                elif args.action is not None or args.clear:
                    config.set_activators(args.source, None if args.clear else bindings, layer=args.layer)
                return config.blob
            writing = bind_write or args.command == "layer-add"
            data = (gpa6_config.edit_ram(ctrl, 5, edit_bindings, save=args.save, expected_uid=uid)
                    if writing else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = ({"source": args.source, "layer": args.layer,
                       "activators": config.activators(args.source, layer=args.layer)}
                      if args.command == "bind" else {"layers": config.layer_ids()})
            if writing:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2))
            return 0
        if response_command:
            def edit_response(data):
                config = gpa6_profile.MappingConfig(data)
                if args.command == "stick":
                    flags = {key: None if getattr(args, key) is None else getattr(args, key) == "on"
                             for key in ("circular", "invert_x", "invert_y")}
                    preset = ("default", "instant", "delay", "custom").index(args.preset) if args.preset else None
                    config.set_stick(args.side, curve_type=preset, center=args.center, edge=args.edge, **flags)
                else:
                    config.set_trigger_curve(args.side, zero=args.zero, end=args.end)
                config.set_response_curve(args.command, args.side, start=args.curve_start,
                    end=args.curve_end, points=[] if args.clear_points else args.point)
                return config.blob
            data = (gpa6_config.edit_ram(ctrl, 5, edit_response, save=args.save, expected_uid=uid)
                    if response_write or args.save else protocol.read_ram(5))
            config = gpa6_profile.MappingConfig(data)
            result = config.stick(args.side) if args.command == "stick" else config.trigger_curve(args.side)
            if response_write or args.save:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(result, indent=2))
            return 0
        if args.command in ("profile", "map", "timing"):
            if args.command == "profile":
                data = protocol.read_ram(5)
            else:
                transform = (lambda data: gpa6_profile.remap(data, args.source, args.target, layer=args.layer)) if args.command == "map" else (
                    lambda data: gpa6_profile.timing(data, long_ms=args.long_ms, double_ms=args.double_ms))
                data = gpa6_config.edit_ram(ctrl, 5, transform, save=args.save, expected_uid=uid)
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(gpa6_profile.describe(data), indent=2))
            return 0
        if args.command == "light":
            def edit_light(data):
                current = gpa6_config.lighting_config(data)
                modes = ("off", "solid", "breathing", "gradient", "streaming", "default")
                mode = modes.index(args.mode) if args.mode else current["base"]["mode"]
                values = current["base"].get("config") or {}
                brightness = args.brightness if args.brightness is not None else values.get("brightness", 50)
                speed = args.speed if args.speed is not None else values.get("speed", 50)
                colors = values.get("colors", [values.get("color", {"r": 255, "g": 255, "b": 255})])
                if args.color:
                    colors = []
                    for color in args.color:
                        if len(color) != 6 or any(c not in "0123456789abcdefABCDEF" for c in color):
                            raise ValueError("colors must be six hexadecimal digits")
                        colors.append(dict(zip(("r", "g", "b"), bytes.fromhex(color))))
                if mode == 1 and len(colors) != 1:
                    raise ValueError("solid lighting requires one color")
                config = (None if mode == 0 else {"color": colors[0], "brightness": brightness} if mode == 1
                          else {"colors": colors, "brightness": brightness, "speed": speed} if mode in (2, 3)
                          else {"brightness": brightness, "speed": speed})
                return gpa6_config.encode_lighting({"base": {"mode": mode, "config": config},
                    "vibration": current["vibration"] if args.vibration is None else args.vibration == "on"})
            data = (gpa6_config.edit_ram(ctrl, 4, edit_light, save=args.save, expected_uid=uid)
                    if light_write else protocol.read_ram(4))
            if args.save and not light_write:
                protocol.save_slot(protocol.slot())
            if light_write or args.save:
                print("Profile save acknowledged." if args.save else "Applied and verified; this firmware can retain edits without explicit save.", file=sys.stderr)
            print(json.dumps(gpa6_config.lighting_config(data), indent=2))
            return 0
        if args.command == "info":
            print(json.dumps({"uid": uid, "info": protocol.info(),
                              "format_versions": protocol.versions(),
                              "experimental": True, "mock": device.is_mock(ctrl.path)}, indent=2))
            return 0
        if args.command == "snapshot":
            data = gpa6_config.snapshot(ctrl, expected_uid=uid)
            data["mock"] = device.is_mock(ctrl.path)
            gpa6_config.write_snapshot(args.output, data)
            print(f"Saved active slot {data['active_slot'] + 1} RAM to {args.output}"
                  + (" [MOCK]" if data["mock"] else ""))
            for name, block in data["blocks"].items():
                if "decode_error" in block:
                    print(f"{name}: raw bytes retained; {block['decode_error']}", file=sys.stderr)
            return 0
        print(f"{identity.name_for(protocol.info()['device_type'])}: experimental grip output; "
              f"UUID {uid}" + (" [MOCK]" if device.is_mock(ctrl.path) else ""), file=sys.stderr)
        session = waveform.GripSession(ctrl, experimental=True, expected_uid=uid, channels=channels)
        session.start()
        start = time.monotonic()
        next_feed = start
        source_frame = 0
        while time.monotonic() - start < duration:
            now = time.monotonic()
            if session is None:
                try:
                    ctrl = open_selected("uid:" + uid)
                    session = waveform.GripSession(ctrl, experimental=True, expected_uid=uid, channels=channels)
                    session.start()
                    next_feed = now
                    source_frame = int((now - start) * 48000)
                except (OSError, device.DeviceNotFound, device.DeviceBusy, identity.WrongDevice, gpa6.ProtocolError):
                    if ctrl:
                        ctrl.close()
                    ctrl = session = None
                    time.sleep(0.25)
                    continue
            try:
                if now >= next_feed:
                    if now - next_feed > session.max_latency:
                        source_frame = int((now - start) * 48000)
                        next_feed = now
                    offset = source_frame
                    if source:
                        source.setpos(min(source.getnframes(), offset))
                        pcm = source.readframes(384)
                    else:
                        values = (round(32767 * args.amplitude * math.sin(2 * math.pi * hz * (offset + i) / 48000))
                                  for i in range(min(384, max(0, int(duration * 48000) - offset)))
                                  for hz in (args.left, args.right))
                        values = list(values)
                        pcm = struct.pack("<" + "h" * len(values), *values)
                    session.feed(pcm, now)
                    source_frame += 384
                    next_feed += waveform.PERIOD
                session.tick(now)
            except (OSError, gpa6.ReplyTimeout, waveform.ProfileChanged) as exc:
                if not args.reconnect:
                    raise
                print(f"{exc}; waiting for UUID {uid}", file=sys.stderr)
                try:
                    session.stop()
                except (OSError, gpa6.ProtocolError):
                    pass
                ctrl.close()
                ctrl = session = None
                continue
            time.sleep(max(0, min(next_feed, session.next_packet) - time.monotonic()))
        return 0
    finally:
        try:
            if session:
                session.stop()
        finally:
            if ctrl:
                ctrl.close()
            if source:
                source.close()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except (OSError, ValueError, wave.Error, identity.WrongDevice, device.DeviceNotFound, device.DeviceBusy) as exc:
        sys.exit(str(exc))
