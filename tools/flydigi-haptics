#!/usr/bin/env python3
"""Drive Apex 5 rumble from DualSense haptic audio.

Games like Deathloop write haptic waveforms to the controller's USB audio
device instead of using the HID motor fields. This listens to such a device and
converts what it hears into rumble.

Point it at a real DualSense to relay its haptics onto the Apex 5:

    tools/flydigi-haptics                    # auto-find a DualSense sink
    tools/flydigi-haptics --sink <name>
    tools/flydigi-haptics --dump             # levels only, do not drive the pad
    tools/flydigi-haptics --watch            # also report what connects

Channel layout and the frequency-split rationale are documented in
flydigi/haptics.py.
"""
import argparse
import os
import select
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import effects, haptics  # noqa: E402
from flydigi.device import Controller, DeviceNotFound  # noqa: E402

CHUNK_FRAMES = 240      # 5 ms -- short enough to track sharp transients
CHANNEL_MAP = "front-left,front-right,rear-left,rear-right"
# parec buffers generously by default, which puts the rumble hundreds of
# milliseconds behind the game and leaves it running on a backlog after the
# haptics stop. Ask for a small buffer, and drop anything we fall behind on.
LATENCY_MS = 8


def log(msg):
    print(f"[haptics] {msg}", flush=True)


def find_dualsense_sink():
    out = subprocess.run(["pactl", "list", "short", "sinks"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and "DualSense" in parts[1]:
            return parts[1]
    return None


def sink_index(sink):
    out = subprocess.run(["pactl", "list", "short", "sinks"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == sink:
            return parts[0]
    return None


def connected_streams(sink):
    """Applications playing into this sink.

    sink-inputs reference the sink by index, so the name has to be resolved
    first -- matching any numeric sink reports every stream on the system.
    """
    index = sink_index(sink)
    if index is None:
        return []
    out = subprocess.run(["pactl", "list", "sink-inputs"],
                         capture_output=True, text=True).stdout
    streams, current, matches = [], None, False
    for line in out.splitlines():
        stripped = line.strip()
        if stripped.startswith("Sink Input #"):
            if matches and current:
                streams.append(current)
            current, matches = None, False
        elif stripped.startswith("Sink:"):
            matches = stripped.split()[-1] == index
        elif "application.name" in stripped:
            current = stripped.split("=", 1)[-1].strip().strip('"')
    if matches and current:
        streams.append(current)
    return streams


def recorder(sink):
    """Headerless capture of the sink's monitor.

    parec, not pw-record: pw-record prepends a file header, which silently
    misaligns a raw reader. The channel map is declared explicitly because
    without it PipeWire remixes and the channel indices stop meaning anything.
    """
    if not shutil.which("parec"):
        sys.exit("need parec (pulseaudio-utils)")
    cmd = ["parec", "-d", f"{sink}.monitor", "--raw", "--format=float32le",
           f"--rate={haptics.RATE}", f"--channels={haptics.CHANNELS}",
           f"--channel-map={CHANNEL_MAP}",
           f"--latency-msec={LATENCY_MS}", f"--process-time-msec={LATENCY_MS}"]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def read_latest(stream, chunk, fd):
    """Return the most recent `chunk` bytes, discarding any backlog.

    Falling behind must not turn into lag: rumble that trails the game by a
    buffer's worth feels sluggish and keeps going after the effect has ended.
    Better to skip audio than to play it late.
    """
    buf = stream.read(chunk)
    if not buf:
        return None, 0
    dropped = 0
    while True:
        ready, _, _ = select.select([fd], [], [], 0)
        if not ready:
            break
        more = stream.read(chunk)
        if not more:
            break
        buf = more
        dropped += 1
    return buf, dropped


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--sink", help="sink to listen on (default: find a DualSense)")
    ap.add_argument("--gain", type=float, default=3.0)
    ap.add_argument("--crossover", type=float, default=haptics.CROSSOVER_HZ,
                    help="Hz dividing low-band (left motor) from high (right)")
    ap.add_argument("--dump", action="store_true",
                    help="print levels only, do not drive the pad")
    ap.add_argument("--watch", action="store_true",
                    help="report applications connecting to the sink")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    sink = args.sink or find_dualsense_sink()
    if not sink:
        sys.exit("no DualSense sink found -- connect one over USB, or pass --sink")

    ctrl = None
    if not args.dump:
        try:
            ctrl = Controller()
            log(f"controller: {ctrl.path}")
        except DeviceNotFound:
            log("Apex 5 not found; running in dump mode")

    log(f"sink: {sink}")
    log(f"crossover {args.crossover:.0f} Hz -> low band drives the left motor "
        f"(large), high band the right (small)")

    splitter = haptics.Splitter(crossover=args.crossover)
    proc = recorder(sink)
    chunk = CHUNK_FRAMES * haptics.FRAME_BYTES

    last = (0, 0)
    seen = set()
    last_watch = 0.0
    dropped_total = 0
    fd = proc.stdout.fileno()
    try:
        while True:
            buf, dropped = read_latest(proc.stdout, chunk, fd)
            if buf is None:
                break
            dropped_total += dropped
            low, high = splitter.process(haptics.unpack(buf))
            motors = haptics.levels_to_motors(low, high, args.gain)

            if args.watch and time.time() - last_watch > 2.0:
                last_watch = time.time()
                for name in connected_streams(sink):
                    if name not in seen:
                        seen.add(name)
                        log(f"STREAM CONNECTED: {name}")

            if motors != last:
                last = motors
                if not args.quiet and (motors != (0, 0) or args.dump):
                    log(f"low={low:.4f} high={high:.4f} -> motors L={motors[0]} "
                        f"R={motors[1]}")
                if ctrl:
                    # wait=0: never block the capture loop on an ACK we ignore
                    effects.rumble(ctrl, motors[0], motors[1], wait=0.0)
    except KeyboardInterrupt:
        pass
    finally:
        proc.terminate()
        if ctrl:
            try:
                effects.rumble(ctrl, 0, 0)
            except OSError:
                pass
            ctrl.close()
        if dropped_total:
            log(f"dropped {dropped_total} stale chunks to stay in sync")
        log("stopped")


if __name__ == "__main__":
    main()
