"""Ask the pad whether it really plays the gyro block at offset 137.

The decompile says the Apex 5 can drive a stick from its own gyro with nothing
running on the host, and says it in enough detail to write the eight bytes --
`MappingConfigParser.ParseMotionConfigToArray`, a target, an enable key, an
enable type, a sensitivity and a dead-zone offset. What no amount of reading
C# settles is whether the firmware acts on any of it, and four questions come
out of that reading with no answer in it:

  * Does the mapping work at all, and is it really gated on the enable key?
  * Is the **second** enable key at byte 7 honoured? The factory leaves D-pad
    Up sitting in it, and Flydigi's writer only ever assigns it under Hold,
    re-emitting whatever it read otherwise -- so either the firmware ignores it
    or every Space Station user has an extra gyro button they did not pick.
  * Does **Click** work? Their UI offers press-to-toggle beside hold-to-use,
    and one byte is the whole difference.
  * Does the **response curve at 830** do anything? Space Station cannot edit
    it -- the panel is hidden by a hardcoded class, the value is passed as
    `Smoothness` and read as `smoothness`, and the save path never assigns it --
    so no pad has ever been asked to play one.

**The enable key is LB, not a paddle.** A paddle would be the natural choice and
is useless here: M1-M6 have no XInput id, so nothing on evdev says whether one
was held, and the reading would be "the stick moved at some point" instead of
"the stick moved exactly while the key was down". LB and RB arrive as BTN_TL and
BTN_TR in the same event stream as the stick, which turns each window into a
correlation rather than a count.

**Both sticks are read, and the untouched one is the control.** The gyro is
pointed at the right stick; the left is never mapped, so anything it reports is
a hand on the shell and the run says so instead of reporting a result.

**Liveness comes from the pad's own motion stream.** A window where nothing
moved and a window where the pad was never tilted look identical from evdev,
and three of the five windows below are only meaningful if a *negative* result
can be trusted. Command 17 turns the vendor report on with `controller_data`
left on beside it, so evdev keeps working, and the run counts how far the pad
was actually tilted while it watched.

**Transitions are counted out on the motors**, in `tools/stick-feel`'s grammar
and no other -- N pulses when window N is set up and waiting for its key, N+1
when it is over and the profile is back. See the note beside `pulse`.

    tools/gyro-map-probe --window 2      # one window, which is how to run it
    tools/gyro-map-probe --seconds 20
    tools/gyro-map-probe                 # all five back to back

Nothing is ever saved. The profile is written and applied, never committed with
command 166, and is put back and read back at the end -- and an applied-but-
unsaved config dies on the pad's next sleep anyway.
"""
import argparse
import os
import select
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from flydigi import device, effects, evdev, identity, mapping, motion

# The mapped stick and the untouched one beside it.
STICKS = {"right": (evdev.ABS_RX, evdev.ABS_RY),
          "left": (evdev.ABS_X, evdev.ABS_Y)}
TARGET = "right"
CONTROL = "left"

# The two gate keys, chosen because evdev carries them -- see the docstring.
GATE = {"lb": evdev.BTN_TL, "rb": evdev.BTN_TR}

# A deflection this big is not noise. Sticks report over a signed 16-bit range
# here, so this is a tenth of full travel and well past any rest jitter.
MOVED = 0.10

# Enough tilt to count as one, in the gyro's own raw units. The pad reports
# hundreds when it is turned by hand and single digits sitting on a desk.
TILTED = 2000

SENSITIVITY = 60
DEAD_ZONE = 15          # Flydigi's own default


# -- rumble, in `tools/stick-feel`'s grammar ----------------------------------
#
# The pad is in both hands and the terminal is behind it, so transitions are
# counted out on the motors. This is `stick-feel`'s `pulse` unchanged, and
# deliberately so: identical short pulses, a count that goes up by one at every
# transition, and no second dimension.
#
#   N pulses    window N is set up -- press its key when you are ready
#   N+1 pulses  that window is over and the profile has been put back
#
# An earlier version of this file had three vocabularies at once -- a count for
# the window, a *long* buzz for the start, two long ones for the end, and the
# left or right grip to say which shoulder. Every one of them was legible on its
# own and together they were unreadable: the pair of long buzzes closing a
# window ran into the short ones opening the next, and the count was gone. The
# window it happened to came back "hardly tilted", because decoding the rumble
# took the attention that tilting the pad needed. One counter, nothing else.
MOTOR_MAX = 160


def pulse(ctrl, count):
    """Say something through the motors, since the screen is not being read."""
    for _ in range(count):
        effects.rumble(ctrl, 0, MOTOR_MAX, wait=0.0)
        time.sleep(0.12)
        effects.rumble(ctrl, 0, 0, wait=0.0)
        time.sleep(0.12)
    time.sleep(0.35)


def flat_curve(config):
    """Flatten the response curve so full tilt asks for no output at all.

    A degenerate value rather than a nudge, for the same reason the trigger
    probe writes a 0..16 window: "does 830 do anything" cannot be answered by a
    curve that merely bends. If the pad plays this one, the gyro goes silent
    while everything about the mapping stays exactly as it was in window 2. If
    it does not, window 5 reads the same as window 2 and the block is inert.
    """
    config.set_motion_curve(zero=0, point1=(0, 0), point2=(127, 0), end=0)


WINDOWS = [
    {
        "name": "baseline",
        "why": "the pad as it is -- tilting must move nothing",
        "setup": None,
        "gate": "lb",
        "expect": "silent",
        "how": "tilt the pad about, holding and releasing LB as you go. "
               "Hands OFF both sticks.",
    },
    {
        "name": "first key, hold",
        "why": "does the mapping work, and is it gated on the key",
        "setup": lambda c: c.set_motion(
            target="right stick", enable_type="hold", keys=("lb", None),
            sensitivity=SENSITIVITY, dead_zone=DEAD_ZONE),
        "gate": "lb",
        "expect": "while down",
        "how": "tilt the pad continuously, holding LB for a few seconds at a "
               "time and letting go in between. Hands OFF both sticks.",
    },
    {
        "name": "second key, hold",
        "why": "is byte 7 honoured on its own",
        "setup": lambda c: c.set_motion(
            target="right stick", enable_type="hold", keys=(None, "rb"),
            sensitivity=SENSITIVITY, dead_zone=DEAD_ZONE),
        "gate": "rb",
        "expect": "while down",
        "how": "same again, but with RB this time -- the first enable key is "
               "cleared, so only byte 7 can turn it on.",
    },
    {
        "name": "first key, click",
        "why": "does press-to-toggle work",
        "setup": lambda c: c.set_motion(
            target="right stick", enable_type="click", keys=("lb", None),
            sensitivity=SENSITIVITY, dead_zone=DEAD_ZONE),
        "gate": "lb",
        "expect": "while up",
        "how": "tap LB and let go, tilt for about five seconds, tap it again, "
               "keep tilting for another five, then tap once more. The reading "
               "is whether the stretches between taps alternate.",
    },
    {
        "name": "flat response curve",
        "why": "does the block at 830 do anything",
        "setup": lambda c: (c.set_motion(
            target="right stick", enable_type="hold", keys=("lb", None),
            sensitivity=SENSITIVITY, dead_zone=DEAD_ZONE), flat_curve(c)),
        "gate": "lb",
        "expect": "curve",
        "how": "exactly as window 2 -- tilt with LB held. The mapping is "
               "identical; only the curve has changed.",
    },
]


def capture(ctrl, seconds, gate, patience=90.0):
    """One window: both sticks and the gate key off evdev, tilt off the pad.

    Returns (samples, tilts), where a sample is (gate_down, deflection of the
    target stick, deflection of the control stick), each deflection a fraction
    of full travel from where that stick sat when the window opened.
    """
    path, name = evdev.find_device(vendor=device.VID, axes=True)
    if path is None:
        sys.exit("no Flydigi gamepad on evdev -- press a button to wake the pad")

    samples = []
    tilts = 0
    gate_code = GATE[gate]
    with evdev.Reader(path) as reader:
        for side, codes in STICKS.items():
            missing = [c for c in codes if c not in reader.abs]
            if missing:
                sys.exit(f"this node reports no axes for the {side} stick")

        while select.select([reader], [], [], 0)[0]:
            reader.read()
        while select.select([ctrl.fd], [], [], 0)[0]:
            os.read(ctrl.fd, 64)

        def deflection(side):
            """How far this stick sits from its own rest, 0..~1.4 diagonally."""
            total = 0.0
            for code in STICKS[side]:
                info = reader.abs[code]
                span = max(1, info.maximum - info.minimum)
                total += ((reader.axes.get(code, rest[code]) - rest[code])
                          / span) ** 2
            return total ** 0.5

        rest = {code: reader.abs[code].value
                for codes in STICKS.values() for code in codes}
        print(f"  {name}: press {gate.upper()} to start the "
              f"{seconds:.0f}s window")
        giveup = time.time() + patience
        while not reader.keys.get(gate_code) and time.time() < giveup:
            if select.select([reader], [], [], 0.2)[0]:
                reader.read()
        if not reader.keys.get(gate_code):
            sys.exit("nothing arrived -- the pad may have slept")
        # Rest is taken after the arming press, not before: the pad has been
        # sitting on a desk until now, and where the sticks sit in the hand is
        # the reference every deflection below is measured from.
        rest = {code: reader.axes.get(code, reader.abs[code].value)
                for codes in STICKS.values() for code in codes}
        while reader.keys.get(gate_code):
            if select.select([reader], [], [], 0.2)[0]:
                reader.read()
        # No cue here on purpose: the key press *is* the start, and whoever
        # made it does not need telling that they made it.
        while select.select([ctrl.fd], [], [], 0)[0]:
            os.read(ctrl.fd, 64)
        print("  started")

        deadline = time.time() + seconds
        while time.time() < deadline:
            ready, _, _ = select.select([reader, ctrl.fd], [], [],
                                        max(0.0, deadline - time.time()))
            for source in ready:
                if source is reader:
                    if reader.read():
                        # Timestamped, because an axis nobody is driving emits
                        # nothing at all: a silent stretch is long in seconds
                        # and empty in samples, and counting samples reads it
                        # as an instant rather than as the answer.
                        samples.append((time.time(),
                                        bool(reader.keys.get(gate_code)),
                                        deflection(TARGET), deflection(CONTROL)))
                else:
                    parsed = motion.parse(os.read(ctrl.fd, 64))
                    if parsed and max(abs(v) for v in parsed[0]) > TILTED:
                        tilts += 1
    print("  window closed")
    return samples, tilts


def liveness(samples, want_down):
    """How much the axis *moved* in one gate state, not how far it sat from rest.

    The distinction the first run was missing. Deflection alone cannot tell a
    stick still being driven from one left parked where the gyro put it: both
    read as "a long way from centre", and only one of them means the mapping is
    still running. Releasing a key that stops updating an axis leaves it exactly
    where it was, so a parked stick is the *expected* shape of a working gate,
    not evidence against one.

    Consecutive samples in the same gate state, mean absolute step. A driven
    axis steps continuously; a parked one steps zero however far out it sits.
    """
    steps, previous = [], None
    for _when, gate, target, _control in samples:
        if gate != want_down:
            previous = None
            continue
        if previous is not None:
            steps.append(abs(target - previous))
        previous = target
    return sum(steps) / len(steps) if steps else 0.0


# A mean step below this is an axis nobody is driving. Full travel is 1.0 and a
# hand-tilted gyro moves the stick in visible fractions of it per event.
DRIVEN = 0.004


def segments(samples):
    """Split the run at each press of the gate key, and score each stretch.

    **Click cannot be read any other way.** Under Hold the two gate states are
    the measurement: driven while down, still while up. Under Click the key is
    tapped and released, so the gyro spends nearly the whole window running with
    the key *up* -- and "driven while up" is equally what an enable key being
    ignored outright would produce. The arming press is itself the gate key, so
    it toggles the mapping on at t=0 and both hypotheses predict the same two
    buckets.

    What tells them apart is what happens after the *next* press. A toggle that
    works alternates: driven, then quiet, then driven. A key that is ignored
    gives one long driven stretch whatever is pressed. So the unit is the
    stretch between presses, not the gate state.

    **Stretches are measured in seconds, not in samples.** An axis nobody is
    driving sends no events, so an off-stretch is empty however long it lasts:
    scored by sample count it looks like an instant, and a run that discarded
    short stretches as noise threw away the only evidence a toggle leaves. A
    stretch is quiet when it lasted a while and produced almost nothing.

    Returns a list of (seconds, samples, mean step) in order.
    """
    out, current, previous, was_down = [], [], None, None
    started = samples[0][0] if samples else 0.0
    last = started
    for when, gate, target, _control in samples:
        if was_down is not None and gate and not was_down:   # rising edge
            out.append((last - started, current))
            started, current, previous = when, [], None
        was_down = gate
        last = when
        if previous is not None:
            current.append(abs(target - previous))
        previous = target
    out.append((last - started, current))
    return [(seconds, len(steps), sum(steps) / len(steps) if steps else 0.0)
            for seconds, steps in out]


# Samples per second below which the axis is not being updated at all. A driven
# stick here reports well over a hundred; a parked one reports none.
DRIVEN_RATE = 20.0


def driven_run(seconds, count, step):
    """Was the axis being updated through this stretch?"""
    if seconds <= 0:
        return False
    return count / seconds > DRIVEN_RATE and step > DRIVEN


def describe(samples, tilts):
    """One window's reading, as the numbers that separate the outcomes."""
    print(f"\n  {tilts} tilt samples over the threshold "
          f"({'the pad was worked' if tilts > 20 else 'BARELY MOVED'})")
    if not samples:
        print("  nothing arrived from evdev at all.")
        return None

    down = [t for _w, gate, t, _c in samples if gate]
    up = [t for _w, gate, t, _c in samples if not gate]
    control = max((c for _w, _g, _t, c in samples), default=0.0)
    print(f"  {len(samples)} stick samples, {len(down)} with the key down, "
          f"{len(up)} with it up")
    driven = {}
    for label, bucket, want in (("key DOWN", down, True), ("key UP", up, False)):
        if not bucket:
            print(f"  {label}: never")
            driven[want] = 0.0
            continue
        driven[want] = liveness(samples, want)
        print(f"  {label}: peak deflection {max(bucket):.2f} of full travel, "
              f"mean step {driven[want]:.4f} "
              f"({'DRIVEN' if driven[want] > DRIVEN else 'parked or still'})")
    runs = segments(samples)
    print("  between presses of the key: "
          + ", ".join(
              f"{seconds:.1f}s "
              f"{'DRIVEN' if driven_run(seconds, n, step) else 'quiet'} "
              f"({n} samples, {n / seconds if seconds else 0:.0f}/s)"
              for seconds, n, step in runs))
    print(f"  control (left stick, never mapped): peak {control:.2f}")
    if control > MOVED:
        print("  WARNING: the untouched stick moved too, so a hand was on the "
              "shell. Treat this window as spoilt and run it again.")
    return {
        "down": max(down) if down else 0.0,
        "up": max(up) if up else 0.0,
        "driven_down": driven[True],
        "driven_up": driven[False],
        "control": control,
        "tilts": tilts,
        "runs": runs,
    }


def verdict(window, reading):
    """What that window says, in the terms it was set up to answer."""
    if reading is None:
        print("  INCONCLUSIVE: no evdev traffic.")
        return
    if reading["tilts"] <= 20:
        print("  INCONCLUSIVE: the pad was hardly tilted, so a silent stick "
              "says nothing. Run this window again.")
        return
    if reading["control"] > MOVED:
        print("  SPOILT: the control stick moved.")
        return

    down, up = reading["down"], reading["up"]
    expect = window["expect"]
    if expect == "curve":
        # Neither outcome is a surprise here, so neither is worded as one: the
        # curve is written to zero output, and the stick either obeys it or the
        # block is not read. Compare against window 2, which is this window with
        # the factory curve in place.
        if reading["driven_down"] > DRIVEN:
            print(f"  INERT: the gyro drove the stick to {down:.2f} of full "
                  "travel with the curve written flat to zero output. The "
                  "firmware does not read the block at 830 -- writing it moves "
                  "bytes and nothing else. Compare window 2.")
        else:
            print("  LIVE: flattening the curve silenced the gyro while the "
                  "mapping was otherwise identical to window 2. The pad plays "
                  "the block at 830.")
        return
    if expect == "silent":
        if max(down, up) <= MOVED:
            print(f"  AS EXPECTED: the stick stayed still throughout "
                  f"(peak {max(down, up):.2f}).")
        else:
            print(f"  UNEXPECTED: the stick moved (peak {max(down, up):.2f}) "
                  "when nothing should have driven it.")
        return

    if expect == "while up":
        # Click, and the gate buckets cannot answer it -- see `segments`. Only
        # a stretch that goes quiet after a press says the key is a toggle
        # rather than something the firmware ignores in this mode.
        # Filtered on duration, never on sample count: an off-stretch is empty
        # by definition, and dropping the empty ones drops the answer.
        runs = [r for r in reading["runs"] if r[0] >= 1.5]
        if not runs:
            print("  INCONCLUSIVE: no stretch between presses lasted long "
                  "enough. Tap the key twice, several seconds apart, tilting "
                  "throughout.")
            return
        driven = [driven_run(*r) for r in runs]
        detail = ", ".join(f"{seconds:.1f}s {'driven' if d else 'quiet'}"
                           for (seconds, _n, _s), d in zip(runs, driven))
        if len(runs) < 2:
            print(f"  INCONCLUSIVE: only one stretch between presses "
                  f"({detail}). The key has to be tapped a second time for the "
                  "toggle to have anything to prove.")
        elif not any(driven):
            print(f"  NOT HONOURED: nothing was driven at all ({detail}).")
        elif all(driven):
            print(f"  NOT A TOGGLE: every stretch was driven ({detail}). "
                  "Pressing the key never switched the gyro off, so in Click "
                  "mode the firmware runs the mapping regardless of the key.")
        else:
            print(f"  TOGGLE WORKS: the stretches alternate ({detail}). A press "
                  "switches the gyro on and a later press switches it off, "
                  "with the key released in between.")
        return

    live, dead = "while down", "while up"
    wanted, other = down, up
    moving, still = reading["driven_down"], reading["driven_up"]

    if wanted <= MOVED or moving <= DRIVEN:
        print(f"  NOT HONOURED: the stick was not driven {live}, with the pad "
              "being tilted throughout. The firmware does not act on this.")
        return
    # Peak deflection cannot settle the other half -- a gate that works leaves
    # the axis parked wherever the gyro last put it, which is a long way from
    # centre and not movement. The mean step is what says which.
    if still > DRIVEN:
        print(f"  LIVE BUT NOT GATED: the stick was driven {live} (step "
              f"{moving:.4f}) and {dead} as well (step {still:.4f}). The "
              "mapping plays; the enable key is not what switches it.")
    elif other > MOVED:
        print(f"  LIVE AND GATED, AND IT DOES NOT RE-CENTRE: driven {live} "
              f"(step {moving:.4f}), and {dead} it stopped moving (step "
              f"{still:.4f}) but stayed {other:.2f} from centre. The key gates "
              "the gyro; letting go leaves the stick parked where it was, which "
              "a game goes on reading as a held stick.")
    else:
        print(f"  LIVE AND GATED: driven {live} (step {moving:.4f}), still and "
              f"centred {dead}. The pad plays this block, and this key is what "
              "turns it on.")


def restore(ctrl, cfg_id, original, edited):
    """Put the profile back, and check that it went back.

    Read back rather than announced, for the reason the trigger probe learnt the
    hard way: a write that reports packets sent is not a write the pad kept, and
    a probe that leaves its own settings behind poisons the next run's idea of
    what "original" was.
    """
    sent = mapping.write_config(ctrl, cfg_id, original, old=edited)
    mapping.apply_config(ctrl, cfg_id)
    try:
        back = mapping.read_config(ctrl, cfg_id)
    except mapping.ProtocolError as exc:
        print(f"\nrestored profile {cfg_id + 1} ({sent} packets) but could not "
              f"read it back to check: {exc}")
        return
    if (back.motion() == original.motion()
            and back.motion_curve() == original.motion_curve()):
        print(f"\nrestored profile {cfg_id + 1} (read back and verified)")
    else:
        print(f"\nWARNING: profile {cfg_id + 1} did NOT go back. It holds "
              f"{back.motion()} and curve {back.motion_curve()}. Nothing was "
              "saved, so a sleep clears it -- but do not treat this profile as "
              "untouched in the next run.")


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.split("\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--window", type=int, action="append",
                    help="run only this window, 1-5; repeatable")
    ap.add_argument("--seconds", type=float, default=15.0,
                    help="how long each window records for (default 15)")
    args = ap.parse_args()

    chosen = args.window or list(range(1, len(WINDOWS) + 1))
    for index in chosen:
        if not 1 <= index <= len(WINDOWS):
            ap.error(f"there is no window {index}")

    try:
        ctrl = device.Controller()
    except device.DeviceNotFound as exc:
        sys.exit(f"error: {exc}")
    try:
        identity.require(ctrl)
    except identity.WrongDevice as exc:
        ctrl.close()
        sys.exit(f"error: {exc}")

    status = mapping.read_status(ctrl)
    if status is None:
        ctrl.close()
        sys.exit("the pad did not answer -- press a button to wake it")
    cfg_id = status["active"]
    original = mapping.read_config(ctrl, cfg_id)
    print(f"profile {cfg_id + 1} ({original.title!r}) -- applied only, never "
          f"saved, restored at the end")
    print(f"as it stands: {original.motion()}")
    print(f"curve: {original.motion_curve()}")

    if not motion.enable(ctrl):
        print("warning: the pad did not acknowledge command 17, so the tilt "
              "count below may stay at zero")

    edited = original.copy()
    readings = {}
    try:
        for index in chosen:
            window = WINDOWS[index - 1]
            print(f"\n=== window {index}: {window['name']} — {window['why']}")
            edited = original.copy()
            if window["setup"] is not None:
                window["setup"](edited)
                mapping.write_config(ctrl, cfg_id, edited, old=original)
                mapping.apply_config(ctrl, cfg_id)
                time.sleep(0.5)
                print(f"  wrote: {edited.motion()}")
            else:
                print("  nothing written")
            print(f"  {window['how']}")
            pulse(ctrl, index)
            samples, tilts = capture(ctrl, args.seconds, window["gate"])
            readings[index] = describe(samples, tilts)
            verdict(window, readings[index])
            # Back to the profile as found between windows, so the next one
            # starts from the pad's own state rather than the last window's.
            mapping.write_config(ctrl, cfg_id, original, old=edited)
            mapping.apply_config(ctrl, cfg_id)
            pulse(ctrl, index + 1)
    finally:
        restore(ctrl, cfg_id, original, edited)
        motion.disable(ctrl)
        effects.rumble(ctrl, 0, 0)
        ctrl.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
