# Access rules for the Flydigi Apex 5 and the virtual DualSense.
#
#   sudo cp udev/72-flydigi-apex5.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# The number matters and 72 is not arbitrary. TAG+="uaccess" only sets a tag;
# what acts on it is systemd's own /usr/lib/udev/rules.d/73-seat-late.rules:
#
#   TAG=="uaccess", ENV{MAJOR}!="", RUN{builtin}+="uaccess"
#
# This file was 99- for its whole life, which runs *after* that, so the tag was
# set and nothing ever read it -- none of these three rules did anything.
# Caught by creating a virtual DualSense and looking at the ACLs: the gamepad
# node had one (from systemd's own 70-uaccess.rules, for joysticks) while the
# touchpad, motion-sensor and headset nodes had none, which is exactly the
# breakage the third rule below exists to prevent.
#
# On many systems none of this is needed -- check first. On Aurora/Fedora the
# hidraw nodes are already world-accessible and the main gamepad node gets a
# uaccess ACL automatically. The rule that usually *is* needed is the third one.

# Apex 5 vendor command interface (trigger effects, rumble, config).
KERNEL=="hidraw*", ATTRS{idVendor}=="37d7", ATTRS{idProduct}=="2501", TAG+="uaccess"

# CD2 charging dock: its switches and its lighting. A separate product id
# rather than a second interface on the pad, and a separate rule for the same
# reason -- the two are unrelated devices that happen to share a vendor.
# Not needed on Aurora/Fedora, where the node already comes up 0666; the pad's
# rule above is not needed there either, and both are here for distributions
# that are stricter.
KERNEL=="hidraw*", ATTRS{idVendor}=="37d7", ATTRS{idProduct}=="6001", TAG+="uaccess"

# The screen chip's bootloader. After command 31 the pad leaves the HID bus and
# comes back as a USB CDC serial device under these ids -- not Flydigi's, and
# not anyone's: ffaa:5555 is a placeholder the chip vendor shipped. The node
# lands as root:dialout, so without this a screen upload gets as far as finding
# the port and then fails to open it, with the pad already switched over.
KERNEL=="ttyACM*", ATTRS{idVendor}=="ffaa", ATTRS{idProduct}=="5555", TAG+="uaccess"

# /dev/uhid, needed to create the virtual DualSense.
KERNEL=="uhid", TAG+="uaccess"

# The virtual DualSense's sub-devices. systemd tags the main gamepad node for
# seat access but leaves the touchpad, motion-sensor and headset-jack nodes
# owned by root:input -- which silently breaks touchpad-click, since that is
# reported on the touchpad node rather than the gamepad one.
# Matches a real DualSense too, which is harmless.
SUBSYSTEM=="input", ATTRS{name}=="Wireless Controller*", TAG+="uaccess"
